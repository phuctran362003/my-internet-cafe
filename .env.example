# EmailJS: https://dashboard.emailjs.com
# Gmail service, then a template whose To Email is your inbox (a fixed address, not a variable).
# Template content can be:
#   Subject: {{subject}}
#   Body: {{message}}
#   To name: {{to_name}}
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
